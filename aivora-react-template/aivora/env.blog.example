# Copy to .env.local (same folder as package.json) and restart npm start.
# Use the SAME secret string in blog-api/.env as ADMIN_SECRET.
#
# This single API URL is used for:
# - Blog CMS
# - Contact form submissions -> stored in blog-api/data/blog.db (all rows kept until you delete in admin)

REACT_APP_BLOG_API_URL=http://localhost:4000
REACT_APP_BLOG_ADMIN_SECRET=change-me-to-a-long-random-string
